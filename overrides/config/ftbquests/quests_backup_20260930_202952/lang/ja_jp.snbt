	file.0000000000000001.title: "The Awakening"
	image.3FFB9CCD2194E93A.title: "Changelog"
	image.6DF4CD4E586826BF.title: "Create a server. Get 25% Off!"
	image.72D9539A5F5A9488.title: "Discord"
	quest.0000000000000010.quest_desc: [
		"§l§nクエストブックの操作:§r"
		""
		"§6クエストブックを開く:§r §e[§r キーを押す（またはキーバインドを確認）"
		""
		"§6ナビゲーション:§r"
		"• 章（チャプター）をクリックして開く"
		"• クエストをクリックして詳細を見る"
		"• マウスホイールで拡大/縮小"
		"• 右クリックしてドラッグで移動"
		""
		"§6クエストの完了:§r"
		"• タスクは完了すると自動的に達成される"
		"• チェックマークをクリックして手動で完了"
		"• 報酬をクリックして受け取る"
		""
		"§6進捗の確認:§r"
		"• 緑色 = 完了"
		"• 黄色 = 進行中"
		"• 赤色 = ロック中（前提クエストが必要）"
	]
	quest.0000000000000010.title: "クエストブックの基本"
	quest.0000000000000020.quest_desc: [
		"§l§nJEI (レシピ表示):§r"
		""
		"§6レシピを見る:§r アイテムにカーソルを合わせて §eR§r"
		"§6使い道を見る:§r アイテムにカーソルを合わせて §eU§r"
		"§6検索:§r 検索バー（右下）をクリック"
		"§6ブックマーク:§r §eA§r でお気に入りの追加/削除"
		"§6チートモード:§r アイテムを §eCtrl + クリック§r（クリエイティブのみ）"
		""
		"§6検索のコツ:§r"
		"• §e@minecraft§r と入力するとバニラのアイテムのみ表示"
		"• §e@create§r と入力するとCreateのアイテムのみ表示"
		"• §e$torch§r と入力するとツールチップを検索"
		"• §e#forge:ingots§r と入力するとタグを検索"
		""
		"§6JEIの切り替え:§r §eCtrl + O§r で表示/非表示"
	]
	quest.0000000000000020.title: "JEI - Just Enough Items"
	quest.0000000000000030.quest_desc: [
		"§l§nインベントリのショートカット:§r"
		""
		"§6クイック移動:§r アイテムを §eShift + クリック§r"
		"§6スタックの分割:§r §e右クリック§r してドラッグ"
		"§6クイッククラフト:§r レシピの出力枠を §eShift + クリック§r（すべてクラフト）"
		"§6アイテムを投げる:§r §eQ§r（長押しでスタックごと）"
		""
		"§6Mouse Tweaks (導入されている場合):§r"
		"• アイテムを持った状態でスロットの上を §eドラッグ§r して配置"
		"• §eShift + ドラッグ§r で同じアイテムを移動"
		"• §e右ドラッグ§r で1スロットにつき1個ずつ配置"
		"• アイテムの上で §eホイール§r して1個ずつ移動"
		""
		"§6ゴミ箱スロット:§r"
		"• インベントリ内のゴミ箱アイコンを探す"
		"• アイテムをドロップして完全に削除"
	]
	quest.0000000000000030.title: "インベントリ管理"
	quest.0000000000000040.quest_desc: [
		"§l§nWaystones (ファストトラベル):§r"
		""
		"§6Waystoneの発見:§r"
		"• 村や構造物に生成される"
		"• 自分でクラフトする（JEIでレシピを確認）"
		""
		"§6有効化:§r Waystoneを §e右クリック§r"
		"• 名前を付ける"
		"• リストに追加される"
		""
		"§6テレポート:§r"
		"• 有効化したWaystoneを §e右クリック§r"
		"• メニューから目的地を選択"
		"• 経験値レベルを消費（一部のModpackではアイテム）"
		""
		"§6Warp Stone:§r"
		"• 携帯用のテレポートアイテムをクラフト"
		"• どこでも使用してWaystoneメニューを開く"
		"• 経験値で再チャージ可能"
	]
	quest.0000000000000040.title: "Waystoneと移動"
	quest.0000000000000050.quest_desc: [
		"§l§nFTB Chunks (土地の保護):§r"
		""
		"§6マップを開く:§r §eM§r キー（またはキーバインドを確認）"
		""
		"§6チャンクの保護 (Claim):§r"
		"• マップを開く (M)"
		"• チャンクのマスを §e左クリック§r"
		"• 他のプレイヤーから保護される"
		"• 保護されたチャンク = 黄色い枠"
		""
		"§6チャンクの常時読み込み (Force Load):§r"
		"• 保護されたチャンクを §eShift + 左クリック§r"
		"• 離れていてもチャンクが読み込まれ続ける"
		"• 機械や農場が動き続ける"
		"• 赤い枠 = 常時読み込み中"
		""
		"§6保護の解除:§r 保護されたチャンクを §e右クリック§r"
		""
		"§6ミニマップ:§r 右上に表示される"
		"• 保護されたエリアを表示"
		"• ウェイポイントを表示"
	]
	quest.0000000000000050.title: "FTB Chunks - 土地の保護"
	quest.0000000000000060.quest_desc: [
		"§l§nJade (ブロックとエンティティの情報):§r"
		""
		"§6Jadeとは？§r"
		"• 見ているブロックやエンティティの情報を表示"
		"• 画面上部に表示される"
		"• 表示内容: 名前、Mod、プログレスバー、内容物"
		""
		"§6役立つ情報:§r"
		"• §6機械:§r エネルギー、液体、進捗"
		"• §6チェスト:§r 開けずに内容物を確認"
		"• §6Mob:§r 体力、防具、エフェクト"
		"• §6作物:§r 成長段階"
		"• §6スポナー:§r Mobの種類、スポーン条件"
		""
		"§6切り替え:§r §eテンキーの 0§r（設定可能）"
		""
		"§6詳細:§r §eテンキーの 1-5§r で詳細レベルを変更"
	]
	quest.0000000000000060.title: "Jade - 私が見ているものは何？"
	quest.0000000000000070.quest_desc: [
		"§l§nNature's Compass:§r"
		""
		"§6クラフト:§r JEIでレシピを確認"
		""
		"§6使い方:§r"
		"1. コンパスを持って §e右クリック§r"
		"2. リストからバイオームを選択"
		"3. §e検索 (Search)§r をクリック"
		"4. コンパスに従ってバイオームへ！"
		""
		"§6機能:§r"
		"• 検索範囲（探索するブロック数）"
		"• ツールチップに距離を表示"
		"• あらゆるバイオームを検索可能"
		"• 再利用可能 - いつでも再検索できる"
		""
		"§6ヒント:§r"
		"• 小さい範囲 (5000) から始める"
		"• 見つからなければ範囲を広げる"
		"• 非常にレアなバイオームもある！"
	]
	quest.0000000000000070.title: "Nature's Compass - バイオーム探し"
	quest.0000000000000080.quest_desc: [
		"§l§nExplorer's Compass:§r"
		""
		"§6クラフト:§r JEIでレシピを確認"
		""
		"§6使い方:§r"
		"1. コンパスを持って §e右クリック§r"
		"2. 構造物（村、寺院など）を選択"
		"3. §e検索 (Search)§r をクリック"
		"4. コンパスに従って構造物へ！"
		""
		"§6見つかるもの:§r"
		"• 村"
		"• 寺院"
		"• 要塞"
		"• 森の洋館"
		"• Modの構造物！"
		""
		"§6プロのヒント:§r"
		"• 構造物によっては特定のディメンション専用"
		"• 今いるディメンションを確認する"
		"• レアな構造物を探す場合は範囲を広げる"
	]
	quest.0000000000000080.title: "Explorer's Compass - 構造物探し"
	quest.0000000000000090.quest_desc: [
		"§l§n覚えておくべき重要なキーバインド:§r"
		""
		"§6§l一般:§r"
		"• §e[§r - クエストブック"
		"• §eM§r - マップ / チャンク保護"
		"• §eR§r - レシピ (アイテムにカーソルを合わせる)"
		"• §eU§r - 使い道 (アイテムにカーソルを合わせる)"
		"• §eO§r - Curios (装備スロット)"
		"• §eC§r - ズーム (長押し) [一部のModpack]"
		""
		"§6§lユーティリティ:§r"
		"• §eF3 + H§r - 高度なツールチップ (IDを表示)"
		"• §eF3 + G§r - チャンク境界を表示"
		"• §eF3 + N§r - ゲームモードの切り替え (クリエイティブ)"
		"• §eF7§r - Mobのスポーン位置を表示 [一部のModpack]"
		""
		"§6§lカスタム:§r"
		"• §e設定 > 操作設定§r を確認"
		"• Mod固有のセクションを探す"
		"• 競合がある場合は再割り当てする"
	]
	quest.0000000000000090.title: "必須のキーバインド"
	quest.0000000000000100.quest_desc: [
		"§l§nCurios (拡張装備スロット):§r"
		""
		"§6Curiosを開く:§r §eO§r キー (またはインベントリのボタン)"
		""
		"§6追加スロット:§r"
		"• §6Ring:§r 指輪用スロット x2"
		"• §6Necklace:§r アミュレット用スロット x1"
		"• §6Belt:§r ベルト用スロット x1"
		"• §6Body:§r マント/チャーム用スロット x1"
		"• §6Hands:§r グローブ用スロット x1"
		"• §6Back:§r バックパック/ケープ用スロット x1"
		"• §6Head:§r 装飾品用スロット x1"
		""
		"§6多くのModがCuriosを使用:§r"
		"• Ars Nouveau (指輪、アミュレット)"
		"• Artifacts (特殊アイテム)"
		"• Vampirism (牙、衣服)"
		"• Iron's Spellbooks (フォーカスアイテム)"
		""
		"§6装備:§r アイテムをスロットにドラッグするだけ！"
	]
	quest.0000000000000100.title: "Curios - 拡張装備スロット"
	quest.0000000000000110.quest_desc: [
		"§l§nSophisticated Storage:§r"
		""
		"§6アップグレード:§r"
		"• チェスト/樽にアップグレードを持って §e右クリック§r"
		"• §6Stack Upgrade:§r スタックサイズを増やす"
		"• §6Pickup Upgrade:§r 近くのアイテムを自動回収"
		"• §6Magnet Upgrade:§r アイテムを吸い寄せる"
		"• §6Void Upgrade:§r 溢れたアイテムを削除"
		"• §6Filter Upgrade:§r 入れるアイテムを制御"
		""
		"§6ストレージメニューを開く:§r"
		"• 素手で §eShift + 右クリック§r"
		"• アップグレードの設定"
		"• フィルターの調整"
		"• ストレージの名前変更"
		""
		"§6リンク:§r"
		"• §6Storage Controller§r を使って複数接続"
		"• 接続されたすべてのストレージに一度にアクセス"
	]
	quest.0000000000000110.title: "Sophisticated Storageのヒント"
	quest.0000000000000120.quest_desc: [
		"§l§nCarry On (ブロックの持ち運び):§r"
		""
		"§6ブロックを持ち上げる:§r"
		"• ブロックを §eスニーク + 右クリック§r"
		"• チェスト、機械、スポナーにも使える！"
		"• 移動中も中身は保持される"
		""
		"§6ブロックを置く:§r"
		"• 置きたい場所で §e右クリック§r"
		"• 中身はすべて保持される"
		""
		"§6エンティティを持ち上げる:§r"
		"• 動物/Mobを §eスニーク + 右クリック§r"
		"• 村人を簡単に移動できる！"
		"• 農場の再編成に最適"
		""
		"§6制限事項:§r"
		"• 持ち運べないブロックもある (設定による)"
		"• 持ち運び中は攻撃できない"
		"• 重いアイテムを持つと移動が遅くなる"
	]
	quest.0000000000000120.title: "Carry On - 物を移動させる"
	quest.0000000000000130.quest_desc: [
		"§l§nFTB Ultimine (一括破壊):§r"
		""
		"§6繋がったブロックを採掘:§r"
		"• §e` (バッククォート)§r キーを長押し"
		"• 1つのブロックを採掘する"
		"• 繋がっているすべてのブロックも破壊される！"
		""
		"§6対象:§r"
		"• 鉱石 (鉱脈全体を採掘)"
		"• 原木 (木全体を伐採)"
		"• 石 (広いエリアを整地)"
		"• その他、似たような繋がったブロック"
		""
		"§6形状モード:§r"
		"• §e`§r を押して形状を切り替え"
		"• Tunnel, Excavate, Escape Tunnel など"
		""
