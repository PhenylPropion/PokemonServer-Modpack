	quest.0000000000000010.quest_desc: [
		"§l§nQUEST BOOK CONTROLS:§r"
		""
		"§6Open Quest Book:§r Press §e[§r key (or check keybinds)"
		""
		"§6Navigate:§r"
		"• Click chapters to open them"
		"• Click quests to view details"
		"• Use mouse wheel to zoom in/out"
		"• Right-click and drag to move around"
		""
		"§6Complete Quests:§r"
		"• Tasks auto-complete when done"
		"• Click checkmark to manually complete"
		"• Click rewards to claim them"
		""
		"§6Track Progress:§r"
		"• Green = Complete"
		"• Yellow = In Progress"
		"• Red = Locked (needs dependencies)"
	]
	quest.0000000000000010.title: "Quest Book Basics"
	quest.0000000000000020.quest_desc: [
		"§l§nJEI (Recipe Viewer):§r"
		""
		"§6View Recipe:§r §eR§r while hovering over item"
		"§6View Uses:§r §eU§r while hovering over item"
		"§6Search:§r Click search bar (bottom right)"
		"§6Bookmark:§r §eA§r to add/remove favorites"
		"§6Cheat Mode:§r §eCtrl + Click§r item (creative only)"
		""
		"§6Search Tips:§r"
		"• Type §e@minecraft§r to show only vanilla items"
		"• Type §e@create§r to show only Create items"
		"• Type §e$torch§r to search tooltips"
		"• Type §e#forge:ingots§r to search tags"
		""
		"§6Toggle JEI:§r §eCtrl + O§r to hide/show"
	]
	quest.0000000000000020.title: "JEI - Just Enough Items"
	quest.0000000000000030.quest_desc: [
		"§l§nINVENTORY SHORTCUTS:§r"
		""
		"§6Quick Move:§r §eShift + Click§r item"
		"§6Split Stack:§r §eRight Click§r and drag"
		"§6Quick Craft:§r §eShift + Click§r recipe output (crafts all)"
		"§6Throw Item:§r §eQ§r (hold for stack)"
		""
		"§6Mouse Tweaks (if installed):§r"
		"• §eDrag§r over slots with item to fill"
		"• §eShift + Drag§r to move matching items"
		"• §eRight Drag§r to place one item per slot"
		"• §eWheel§r over item to move single items"
		""
		"§6Trash Slot:§r"
		"• Look for trash icon in inventory"
		"• Drop items to delete permanently"
	]
	quest.0000000000000030.title: "Inventory Management"
	quest.0000000000000040.quest_desc: [
		"§l§nWAYSTONES (Fast Travel):§r"
		""
		"§6Find Waystones:§r"
		"• Generated in villages and structures"
		"• Craft your own (check JEI recipe)"
		""
		"§6Activate:§r §eRight-click§r waystone"
		"• Give it a name"
		"• It's now in your list"
		""
		"§6Teleport:§r"
		"• §eRight-click§r any activated waystone"
		"• Select destination from menu"
		"• Costs XP levels (or items in some packs)"
		""
		"§6Warp Stone:§r"
		"• Craft portable teleporter"
		"• Use anywhere to open waystone menu"
		"• Rechargeable with XP"
	]
	quest.0000000000000040.title: "Waystones And Travel"
	quest.0000000000000050.quest_desc: [
		"§l§nFTB CHUNKS (Land Claiming):§r"
		""
		"§6Open Map:§r §eM§r key (or check keybinds)"
		""
		"§6Claim Chunk:§r"
		"• Open map (M)"
		"• §eLeft-click§r a chunk square"
		"• Protects from other players"
		"• Claimed chunks = yellow border"
		""
		"§6Force Load Chunk:§r"
		"• §eShift + Left-click§r claimed chunk"
		"• Keeps chunk loaded when you're away"
		"• Machines/farms keep working"
		"• Red border = force loaded"
		""
		"§6Unclaim:§r §eRight-click§r claimed chunk"
		""
		"§6Minimap:§r Shows in top-right corner"
		"• Shows claimed areas"
		"• Shows waypoints"
	]
	quest.0000000000000050.title: "FTB Chunks - Claiming Land"
	quest.0000000000000060.quest_desc: [
		"§l§nJADE (Block & Entity Info):§r"
		""
		"§6What is Jade?§r"
		"• Shows info about blocks/entities you look at"
		"• Displays at top of screen"
		"• Shows: Name, mod, progress bars, contents"
		""
		"§6Useful Info:§r"
		"• §6Machines:§r Energy, fluid, progress"
		"• §6Chests:§r Contents without opening"
		"• §6Mobs:§r Health, armor, effects"
		"• §6Crops:§r Growth stage"
		"• §6Spawners:§r Mob type, spawn conditions"
		""
		"§6Toggle:§r §eNumpad 0§r (configurable)"
		""
		"§6Advanced:§r §eNumpad 1-5§r for detail levels"
	]
	quest.0000000000000060.title: "Jade - What Am I Looking At?"
	quest.0000000000000070.quest_desc: [
		"§l§nNATURE'S COMPASS:§r"
		""
		"§6Craft:§r Check JEI recipe"
		""
		"§6Use:§r"
		"1. §eRight-click§r with compass"
		"2. Select biome from list"
		"3. Click §eSearch§r"
		"4. Follow compass to biome!"
		""
		"§6Features:§r"
		"• Search radius (blocks to search)"
		"• Distance shown in tooltip"
		"• Can search for ANY biome"
		"• Reusable - search again anytime"
		""
		"§6Tips:§r"
		"• Start with small radius (5000)"
		"• Increase if nothing found"
		"• Some biomes are very rare!"
	]
	quest.0000000000000070.title: "Nature's Compass - Find Biomes"
	quest.0000000000000080.quest_desc: [
		"§l§nEXPLORER'S COMPASS:§r"
		""
		"§6Craft:§r Check JEI recipe"
		""
		"§6Use:§r"
		"1. §eRight-click§r with compass"
		"2. Select structure (village, temple, etc.)"
		"3. Click §eSearch§r"
		"4. Follow compass to structure!"
		""
		"§6Finds:§r"
		"• Villages"
		"• Temples"
		"• Strongholds"
		"• Mansions"
		"• Mod structures!"
		""
		"§6Pro Tip:§r"
		"• Some structures are dimension-specific"
		"• Check what dimension you're in"
		"• Increase radius for rare structures"
	]
	quest.0000000000000080.title: "Explorer's Compass - Find Structures"
	quest.0000000000000090.quest_desc: [
		"§l§nKEY KEYBINDS TO REMEMBER:§r"
		""
		"§6§lGeneral:§r"
		"• §e[§r - Quest Book"
		"• §eM§r - Map/Chunk Claiming"
		"• §eR§r - Recipe (hover item)"
		"• §eU§r - Uses (hover item)"
		"• §eO§r - Curios (equipment slots)"
		"• §eC§r - Zoom (hold) [some packs]"
		""
		"§6§lUtility:§r"
		"• §eF3 + H§r - Advanced tooltips (show IDs)"
		"• §eF3 + G§r - Show chunk borders"
		"• §eF3 + N§r - Cycle gamemode (creative)"
		"• §eF7§r - Show mob spawns [some packs]"
		""
		"§6§lCustom:§r"
		"• Check §eOptions > Controls§r"
		"• Look for mod-specific sections"
		"• Rebind if conflicts exist"
	]
	quest.0000000000000090.title: "Essential Keybinds"
	quest.00000000000000BB.quest_subtitle: "Locate the End portal."
	quest.0000000000000100.quest_desc: [
		"§l§nCURIOS (Equipment Slots):§r"
		""
		"§6Open Curios:§r §eO§r key (or button in inventory)"
		""
		"§6Extra Slots:§r"
		"• §6Ring:§r 2 slots for rings"
		"• §6Necklace:§r 1 slot for amulets"
		"• §6Belt:§r 1 slot for belts"
		"• §6Body:§r 1 slot for cloaks/charms"
		"• §6Hands:§r 1 slot for gloves"
		"• §6Back:§r 1 slot for backpacks/capes"
		"• §6Head:§r 1 slot for cosmetics"
		""
		"§6Many Mods Use Curios:§r"
		"• Ars Nouveau (rings, amulets)"
		"• Artifacts (special items)"
		"• Vampirism (fangs, clothes)"
		"• Iron's Spellbooks (focus items)"
		""
		"§6Equip:§r Just drag item to slot!"
	]
	quest.0000000000000100.title: "Curios - Extra Equipment Slots"
	quest.0000000000000110.quest_desc: [
		"§l§nSOPHISTICATED STORAGE:§r"
		""
		"§6Upgrades:§r"
		"• §eRight-click§r chest/barrel with upgrade"
		"• §6Stack Upgrade:§r Increase stack size"
		"• §6Pickup Upgrade:§r Auto-pickup nearby items"
		"• §6Magnet Upgrade:§r Suck in items"
		"• §6Void Upgrade:§r Delete excess items"
		"• §6Filter Upgrade:§r Control what goes in"
		""
		"§6Open Storage Menu:§r"
		"• §eShift + Right-click§r with empty hand"
		"• Configure upgrades"
		"• Adjust filters"
		"• Rename storage"
		""
		"§6Linking:§r"
		"• Use §6Controller§r to link multiple"
		"• Access all connected storage at once"
	]
	quest.0000000000000110.title: "Sophisticated Storage Tips"
	quest.0000000000000120.quest_desc: [
		"§l§nCARRY ON (Pick Up Blocks):§r"
		""
		"§6Pick Up Block:§r"
		"• §eSneak + Right-click§r block"
		"• Works on chests, machines, spawners!"
		"• Items stay inside when moved"
		""
		"§6Place Block:§r"
		"• §eRight-click§r where you want it"
		"• All contents preserved"
		""
		"§6Pick Up Entities:§r"
		"• §eSneak + Right-click§r animals/mobs"
		"• Move villagers easily!"
		"• Great for reorganizing farms"
		""
		"§6Limitations:§r"
		"• Some blocks can't be moved (config)"
		"• Can't attack while carrying"
		"• Move slower while carrying heavy items"
	]
	quest.0000000000000120.title: "Carry On - Move Stuff"
	quest.0000000000000130.quest_desc: [
		"§l§nFTB ULTIMINE (Veinminer):§r"
		""
		"§6Mine Connected Blocks:§r"
		"• Hold §e` (grave/tilde)§r key"
		"• Mine one block"
		"• All connected blocks break too!"
		""
		"§6Works On:§r"
		"• Ores (mine entire vein)"
		"• Logs (chop entire tree)"
		"• Stone (clear large areas)"
		"• Any similar connected blocks"
		""
		"§6Shape Modes:§r"
		"• Press §e`§r to cycle shapes"
		"• Tunnel, Excavate, Escape Tunnel, etc."
		""
		"§6Limits:§r"
		"• Uses tool durability per block"
		"• Requires enough hunger"
		"• Max blocks per use (config)"
	]
	quest.0000000000000130.title: "FTB Ultimine - Veinminer"
	quest.0000000000000140.quest_desc: [
		"§l§nMOD GUIDE BOOKS:§r"
		""
		"§6Many Mods Have Guide Books:§r"
		"• §6Ars Nouveau:§r Worn Notebook"
		"• §6Occultism:§r Dictionary of Spirits"
		"• §6Vampirism:§r Vampire Book"
		"• §6Botania:§r Lexica Botania"
		"• §6Create:§r Engineer's Manual"
		""
		"§6How to Get:§r"
		"• Some given as quest rewards"
		"• Craft them (check JEI)"
		"• Find in world loot"
		""
		"§6Why Use Them:§r"
		"• Detailed mod explanations"
		"• Recipes and tutorials"
		"• Better than wiki sometimes!"
		"• Searchable content"
		""
		"§6Always check JEI for guide book recipes!§r"
	]
	quest.0000000000000140.title: "Patchouli Guide Books"
	quest.0000000000000150.quest_desc: [
		"§l§6Congratulations!§r"
		""
		"You've learned all the essential shortcuts and features!"
		""
		"§l§nYou now know:§r"
		"• How to use the Quest Book"
		"• JEI recipe viewer"
		"• Inventory shortcuts"
		"• Fast travel with Waystones"
		"• Chunk claiming"
		"• Equipment slots (Curios)"
		"• Veinminer (Ultimine)"
		"• And much more!"
		""
		"§6You're ready to start §lChapter 1: Humble Beginnings§r!"
		""
		"§eGood luck on your journey through The Awakening!§r"
	]
	quest.0000000000000150.title: "Tutorial Complete!"
	quest.0027DC69B16F02D8.quest_desc: ["you lay eggs"]
	quest.0027DC69B16F02D8.quest_subtitle: "Want to be a chicken?"
	quest.002CB0D3F7AF8351.quest_desc: ["ノロイノヨロイの入手を達成し、育成素材と通貨を獲得します。"]
	quest.002CB0D3F7AF8351.title: "ノロイノヨロイの入手"
