	quest.483F46923D0318E9.quest_desc: ["爽快な青色のポケモン図鑑を作成または入手します。"]
	quest.483F46923D0318E9.title: "あおのポケモンずかん"
	quest.484616F9CD0B72F3.quest_subtitle: "Sub-Legendary"
	quest.485A6A09742C212D.quest_desc: ["ほのおのいし鉱石の発見を達成し、育成素材と通貨を獲得します。"]
	quest.485A6A09742C212D.title: "ほのおのいし鉱石の発見"
	quest.487DCF5728E69E28.quest_subtitle: "Sub-Legendary"
	quest.4882C5926DBE023C.quest_desc: [
		"           &fA &eKeystone &fis the main"
		"   &fingredient for the &6Mega Bracelet&f,"
		"    &fThe key item for &eMega Evolution&f."
		"  &fObtain it by breaking &bKeystone Ore&f,"
		"           &fFound inside &cMegaroids&f."
		"        &fA &bDiamond &fpickaxe or higher"
		"            &fIs required to mine it."
	]
	quest.4882C5926DBE023C.quest_subtitle: "Craft"
	quest.4883EE3FD3FEB319.quest_desc: ["Generates under Deserts between Y=-64 and Y=32 (mostly Y=-16)"]
	quest.4890308F6A77A05C.quest_subtitle: "Loot a chest in a Bastion Remnant"
	quest.48A05B1D69740266.quest_desc: ["Gotta Collect Them All..."]
	quest.48F72FB206687BEF.quest_desc: ["くさタイプ捕獲を達成し、育成用のアメと記念ボールを獲得します。"]
	quest.48F72FB206687BEF.title: "くさタイプ捕獲"
	quest.4908B25878C2DA24.quest_desc: [
		"【ガンテツボールまとめ買い】"
		"つりざおで釣り上げたポケモンを捕まえやすいボールです。"
	]
	quest.4908B25878C2DA24.title: "購入: ルアーボール (8個)"
	quest.490DDCFD99C9DCD5.quest_subtitle: "Restore 100 hp"
	quest.49133CFAF5DC3CDE.quest_desc: ["Generates in The End between Y=0 and Y=32 (mostly Y=16)"]
	quest.49252E69574928BD.quest_desc: ["ビーコンバッジの獲得（デンジ）を達成し、勝利の証と名誉ある報酬を獲得します。"]
	quest.49252E69574928BD.title: "ビーコンバッジの獲得（デンジ）"
	quest.493B5B1E7EF014AA.title: "Runic Tablet"
	quest.495CF4FBE9C64AAD.quest_desc: ["ネストロッドの作成を完了し、対応するボールと釣り用アメを獲得します。"]
	quest.495CF4FBE9C64AAD.title: "ネストロッドの作成"
	quest.495E1DA7D26E3C31.quest_desc: [
		"You cant redeem these more than once, they are there so players can have mounts if they arent spawning"
		""
		"you can use a summoning staff on your mount to bound it"
		"this will let you teleport your mount when you use the staff, or use it to tell your mount what to do (sit, follow or wander)"
	]
	quest.499275E8CB0B2E69.quest_desc: ["I suggest using oak chest for the upgrades with stack and tier upgrades to store more villagers and even more items for your autro trader."]
	quest.499275E8CB0B2E69.title: "Oak Chest"
	quest.49D6DC1114D0FCDC.quest_desc: ["リピートロッドの作成を完了し、対応するボールと釣り用アメを獲得します。"]
	quest.49D6DC1114D0FCDC.title: "リピートロッドの作成"
	quest.49E126D48120DC09.quest_desc: ["Just making it easier to get around"]
	quest.49E126D48120DC09.quest_subtitle: "Tempad Kit"
	quest.49E126D48120DC09.title: "Welcome Package"
	quest.4A0D9ABF10B8F8CB.title: "Skill Pages"
	quest.4A4B588D212312EE.quest_desc: ["A Poké Ball is a tool used for catching and storing caught Pokémon."]
	quest.4A7CB8DB73B02CC5.quest_subtitle: "Special Defense / Special Attack"
	quest.4A8F45900D280C52.quest_subtitle: "Mythical"
	quest.4AB189CDDC01699A.title: "Experience Harvesting"
	quest.4AC05265DFA77DA8.quest_desc: ["Obtain The Watcher"]
	quest.4ACD81E9F7D526B4.quest_desc: [
		"【ダイマックス解放装具】"
		"ガラル粒子のエネルギーを制御し、ダイマックスを発動可能にするバンドです。"
	]
	quest.4ACD81E9F7D526B4.title: "購入: ダイマックスバンド (ダイマックス解放)"
	quest.4AD3B372FC29D8E2.quest_desc: [
		"【最高峰育成アイテム】"
		"ポケモンの全ステータスの個体値を最高（鍛えた！）にする究極の王冠です。"
	]
	quest.4AD3B372FC29D8E2.title: "購入: きんのおうかん (全個体値V)"
	quest.4AE260F891489073.quest_desc: ["ギンガ団ボス アカギ最終決戦を達成し、勝利の証と名誉ある報酬を獲得します。"]
	quest.4AE260F891489073.title: "ギンガ団ボス アカギ最終決戦"
	quest.4B00000000000001.quest_desc: [
		"§l§6Welcome to Create!§r"
		""
		"This chapter teaches you all the tips, tricks, and shortcuts for mastering Create mod."
		""
		"§6Create is different from other tech mods:§r"
		"• Uses §erotational power§r instead of energy"
		"• Emphasizes §emechanical contraptions§r"
		"• Highly §evisual and interactive§r"
		"• Extremely §eautomation-friendly§r"
		""
		"§eComplete Chapter 4 (Mechanical Mastery) alongside this!§r"
	]
	quest.4B00000000000001.title: "Welcome to Create!"
	quest.4B00000000000010.quest_desc: [
		"§l§nTHE WRENCH:§r"
		""
		"§6Essential Tool - Always carry one!§r"
		""
		"§6§lBasic Uses:§r"
		"• §eRight-click§r block: Rotate/configure"
		"• §eShift + Right-click§r: Pick up instantly (keeps inventory!)"
		"• §eRight-click§r belt/pipe: Change direction"
		"• §eRight-click§r cogwheel: See speed/stress info"
		""
		"§6§lAdvanced:§r"
		"• Configure §6filters§r in funnels/tunnels"
		"• Adjust §6gear ratios§r by clicking cogs"
		"• Flip §6mechanical pistons§r direction"
		"• Change §6belt§r item routing"
		""
		"§eTIP: Shift-wrench to move machines without breaking them!§r"
	]
	quest.4B00000000000010.title: "The Wrench - Your Best Friend"
	quest.4B00000000000020.quest_desc: [
		"§l§nENGINEER'S GOGGLES:§r"
		""
		"§6Must-Have Item!§r Wear in head/curios slot"
		""
		"§6§lWhat You See:§r"
		"• §eRotation speed§r (RPM) of components"
		"• §eStress impact§r vs §ecapacity§r"
		"• §eOverstressed§r components (red)"
		"• §eConnected networks§r highlighted"
		"• §eFluid/item contents§r in pipes"
		"• §eFilter settings§r on logistics"
		""
		"§6§lColor Codes:§r"
		"• §aGreen§r = Working perfectly"
		"• §eYellow§r = Nearing stress limit"
		"• §cRed§r = Overstressed (stopped)"
		""
		"§eTIP: Press K (or check keybinds) for overlay toggle§r"
	]
	quest.4B00000000000020.title: "Engineer's Goggles - See Everything"
	quest.4B00000000000030.quest_desc: [
		"§l§nROTATIONAL POWER BASICS:§r"
		""
		"§6§lSpeed (RPM):§r"
		"• How fast component spins"
		"• Faster = quicker processing"
		"• Some machines have speed limits!"
		""
		"§6§lStress (SU):§r"
		"• Each machine needs stress units"
		"• Generators provide capacity"
		"• Don't exceed capacity or network stops!"
		""
		"§6§lChanging Speed:§r"
		"• §eCogwheel to Large Cogwheel§r = 2x slower, 2x torque"
		"• §eLarge to Small Cogwheel§r = 2x faster"
		"• §eGearbox§r = change axis without speed change"
		"• §eRotation Speed Controller§r = precise control"
		""
		"§eTIP: More stress capacity ≠ faster. Speed and stress are separate!§r"
	]
	quest.4B00000000000030.title: "Understanding Rotation"
	quest.4B00000000000040.quest_desc: [
		"§l§nPOWER GENERATION:§r"
		""
		"§6§lEarly Game:§r"
		"• §6Water Wheel:§r 3 blocks of flowing water = best"
		"• §6Windmill:§r 8 wool sails, open area, good wind"
		"• §6Hand Crank:§r Manual power for small tasks"
		""
		"§6§lMid Game:§r"
		"• §6Furnace Engine:§r Uses blaze burners + flywheel"
		"• §6Steam Engine:§r Needs boiler + water + heat"
		""
		"§6§lLate Game:§r"
		"• §6Multiple Steam Engines:§r Stack for massive power"
		"• §6Creative Motor:§r Creative only, infinite power"
		""
		"§6§lPower Tips:§r"
		"• Connect multiple generators to same network"
		"• Use §eClutch§r to disconnect on/off"
		"• Add §eSpeed Controller§r for precision"
	]
	quest.4B00000000000040.title: "Power Generation Guide"
	quest.4B00000000000050.quest_desc: [
		"§l§nMECHANICAL BELTS:§r"
		""
		"§6§lCreating Belts:§r"
		"• Place 2+ shafts in line"
		"• §eRight-click§r first shaft with belt connector"
		"• §eRight-click§r second shaft"
		"• Max distance: 20 blocks"
		""
		"§6§lBelt Features:§r"
		"• Transport items automatically"
		"• Can go uphill (1 block max slope)"
		"• Use with §6Andesite Funnel§r to extract"
		"• Use with §6Brass Funnel§r for filters"
		""
		"§6§lBelt Tricks:§r"
		"• §eWrench§r belt to reverse direction"
		"• Place §6Andesite Tunnel§r for crossings"
		"• Use §6Belt Observer§r to detect items"
		"• Combine with §6Encased Fan§r for processing"
		""
		"§eTIP: Belts can be dyed! Right-click with dye§r"
	]
	quest.4B00000000000050.title: "Belt Mechanics And Tricks"
	quest.4B00000000000060.quest_desc: [
		"§l§nITEM LOGISTICS:§r"
		""
		"§6§lAndesite Funnel:§r (Basic)"
		"• Extract/insert from containers"
		"• §eWrench§r to change in/out mode"
		"• No filtering"
		""
		"§6§lBrass Funnel:§r (Advanced)"
		"• Same as Andesite"
		"• §e+ Filter slots§r (click with wrench)"
		"• Whitelist/blacklist mode"
		"• Can respect NBT data"
		""
		"§6§lChutes:§r"
		"• Drop items down"
		"• §eSmart Chute§r = powered on/off"
		"• Can filter like brass funnel"
		""
		"§6§lTunnels:§r"
		"• §6Andesite Tunnel§r: Cross belts without mixing"
		"• §6Brass Tunnel§r: Distribute/sync items"
		""
		"§eTIP: Wrench funnels to see all settings!§r"
	]
	quest.4B00000000000060.title: "Funnels, Chutes And Item Movement"
	quest.4B00000000000070.quest_desc: [
		"§l§nENCASED FAN PROCESSING:§r"
		""
		"§6§lBasic Setup:§r"
		"1. Place §6Encased Fan§r"
		"2. Power it with rotation"
		"3. Place heat source 2 blocks in front"
		"4. Items pass through the wind"
		""
		"§6§lProcessing Types:§r"
		"• §6Fire§r (lava/fire) = §eSmelting§r"
		"• §6Water§r = §eWashing§r (get nuggets from crushed ore)"
		"• §6Soul Fire§r = §eHaunting§r (soul sand recipes)"
		"• §6Nothing§r = §eBlowing§r (crafting recipes)"
		""
		"§6§lBest Practices:§r"
		"• Use with belts for automation"
		"• 2-block gap between fan and heat"
		"• Items need ~3 blocks in the wind"
		""
		"§eTIP: Check JEI for fan processing recipes!§r"
	]
	quest.4B00000000000070.title: "Processing with Fans"
	quest.4B00000000000080.quest_desc: [
		"§l§nPRESS And BASIN:§r"
		""
		"§6§lMechanical Press:§r"
		"• Place above §6Belt§r or §6Basin§r"
		"• Power with rotation"
		"• Compresses items (ingots → plates)"
		""
		"§6§lBasin Uses:§r"
		"• Holds items for processing"
		"• Use with §6Press§r for compacting"
		"• Use with §6Mixer§r for mixing recipes"
		"• Use with §6Blaze Burner§r for heated recipes"
		""
		"§6§lAutomation:§r"
		"• §eFunnel§r items into basin"
		"• §eChute§r below basin extracts output"
		"• Multiple presses = faster processing"
		""
		"§6§lCommon Recipes:§r"
		"• Iron Ingot → Iron Sheet"
		"• Copper Ingot → Copper Sheet"
		"• Sugar Cane → Paper"
	]
	quest.4B00000000000080.title: "Mechanical Press And Basin"
	quest.4B00000000000090.quest_desc: [
		"§l§nMECHANICAL MIXER:§r"
		""
		"§6§lSetup:§r"
		"• Place above §6Basin§r"
		"• Power with rotation (must be fast enough)"
		"• Add ingredients to basin"
		"• Mixer automatically starts"
		""
		"§6§lImportant Recipes:§r"
		"• §6Andesite Alloy§r: Andesite + Iron Nuggets"
		"• §6Brass§r: Copper + Zinc (needs blaze burner)"
		"• §6Chocolate§r: Cocoa + Milk"
		"• §6Dough§r: Wheat + Water"
		""
		"§6§lHeated Mixing:§r"
		"• Place §6Blaze Burner§r under basin"
		"• Required for brass, rose quartz, etc."
		"• §eSuperheated§r (blue) = faster recipes"
		""
		"§eTIP: Check JEI - many recipes need heated mixing!§r"
	]
	quest.4B00000000000090.title: "Mechanical Mixer Magic"
	quest.4B00000000000100.quest_desc: [
		"§l§nCRUSHING WHEELS:§r"
		""
		"§6§lSetup (Critical!):§r"
		"• Place 2 crushing wheels §e1 block apart§r"
		"• Both must rotate §einward§r (towards gap)"
		"• Same speed required"
		"• Items drop in the gap between"
		""
		"§6§lPower Connection:§r"
		"• Connect §ecogwheels on top§r"
		"• Use §egearbox§r to connect both wheels"
		"• Rotation direction matters!"
		""
		"§6§lAutomation:§r"
		"• §eChute§r above to drop items"
		"• §eBelt§r below to catch crushed output"
		"• Much faster than millstone!"
		""
		"§6§lBonus Outputs:§r"
		"• Ores give extra gems/nuggets"
		"• Cobble → Gravel → Sand → Clay"
		"• Wheat → 2-3x seeds"
	]
	quest.4B00000000000100.title: "Crushing Wheels Mastery"
	quest.4B00000000000110.quest_desc: [
		"§l§nFLUID SYSTEMS:§r"
		""
		"§6§lFluid Tanks:§r"
		"• §eRight-click§r with bucket to fill/empty"
		"• Stack up to 2 high (4 = 64 buckets)"
		"• Use §eWrench§r to configure in/out"
		""
		"§6§lMechanical Pump:§r"
		"• Needs rotational power"
		"• §eFaster rotation = faster pumping§r"
		"• Direction matters! Wrench to reverse"
		"• Max 16 blocks of pipe per pump"
		""
		"§6§lFluid Pipes:§r"
		"• §6Copper Pipe§r: Basic fluid transport"
		"• §6Glass Pipe§r: See fluid inside"
		"• Pumps can push through multiple pipes"
		""
		"§6§lHose Pulley:§r"
		"• Pump infinite water/lava from pools"
		"• Needs 10,000+ source blocks for infinite"
	]
	quest.4B00000000000110.title: "Fluid Handling Basics"
	quest.4B00000000000120.quest_desc: [
		"§l§nCONTRAPTIONS:§r"
		""
		"§6§lWhat Are Contraptions?§r"
		"Moving assemblies of blocks that work together!"
		""
		"§6§lMechanical Piston:§r"
		"• Pushes blocks up to 16 blocks"
		"• Use §eSuper Glue§r to attach blocks"
		"• §ePiston Extension Pole§r for range"
		""
		"§6§lMechanical Bearing:§r"
		"• Rotates structures (windmills, wheels)"
		"• Attach blocks with §eSuper Glue§r"
		"• Max size: 1024 blocks"
		""
		"§6§lGantry:§r"
		"• Move along shafts horizontally"
		"• Combine for 2D/3D movement"
		""
		"§6§lSuper Glue:§r"
		"• §eRight-click§r between blocks to attach"
		"• All glued blocks move together"
		"• §eWrench§r to remove glue"
	]
	quest.4B00000000000120.title: "Contraptions - Moving Machines!"
	quest.4B00000000000130.quest_desc: [
		"§l§nAUTOMATED FARMING:§r"
		""
		"§6§lMechanical Harvester:§r"
		"• Attach to contraption (bearing/piston)"
		"• Breaks crops automatically"
		"• Collects drops into contraption inventory"
		"• Works on wheat, carrots, trees, etc."
		""
		"§6§lMechanical Plough:§r"
		"• Tills dirt into farmland"
		"• Attach to same contraption as harvester"
		"• Breaks crops (use harvester instead)"
		""
		"§6§lBasic Farm Setup:§r"
		"1. §6Mechanical Bearing§r on center"
		"2. Attach §6Harvesters§r facing outward"
		"3. Add §6Chest§r to collect items"
		"4. Power bearing to rotate"
		"5. Use §eFunnels§r to extract from chest"
		""
		"§eTIP: Add deployers with bone meal for auto-replanting!§r"
	]
	quest.4B00000000000130.title: "Mechanical Harvester And Plough"
	quest.4B00000000000140.quest_desc: [
		"§l§nDEPLOYER:§r"
		""
		"§6§lWhat It Does:§r"
		"• Simulates §eright-click§r or §eleft-click§r"
		"• Can hold and use items"
		"• Works as a player would"
		""
		"§6§lModes:§r"
		"• §ePunch§r: Left-click (breaks blocks, attacks)"
		"• §eUse§r: Right-click (places, activates)"
		"• Toggle with §eWrench§r"
		""
		"§6§lInserting Items:§r"
		"• Use §eFunnel§r or pipe into deployer"
		"• Deployer holds item in filter slot"
		"• Use wrench to see/set filter"
		""
		"§6§lCommon Uses:§r"
		"• Place blocks (on contraptions)"
		"• Apply bone meal"
		"• Activate buttons/levers"
		"• Shear sheep"
		"• Fill/empty buckets"
		"• Right-click machines"
	]
	quest.4B00000000000140.title: "Deployer - Mechanical Hands"
	quest.4B00000000000150.quest_desc: [
		"§l§nDRILL And SAW:§r"
		""
		"§6§lMechanical Drill:§r"
		"• Breaks blocks like pickaxe"
		"• Attach to contraption"
		"• Speed = mining speed"
		"• Drops go into contraption inventory"
		""
		"§6§lMechanical Saw:§r"
		"• Breaks blocks like axe"
		"• §eSpecial:§r Chops entire trees!"
		"• Can cut blocks in half (stairs, slabs)"
		"• Place above belt for automated cutting"
		""
		"§6§lMining Contraption:§r"
		"1. §6Mechanical Bearing§r/§6Piston§r"
		"2. Attach §6Drills§r facing forward"
		"3. Add §6Chest§r for drops"
		"4. Use §6Deployer§r to place tracks/blocks"
		"5. Power to move and mine!"
		""
		"§eTIP: Saw on belt = Stonecutter recipes!§r"
	]
	quest.4B00000000000150.title: "Mechanical Drill And Saw"
	quest.4B00000000000160.quest_desc: [
		"§l§nREDSTONE INTEGRATION:§r"
		""
		"§6§lClutch:§r"
		"• Disconnects rotation when powered"
		"• Useful for on/off machines"
		""
		"§6§lGearshift:§r"
		"• Reverses rotation when powered"
		"• Toggle direction easily"
		""
		"§6§lSequenced Gearshift:§r"
		"• Program rotation sequences"
		"• Speed up, slow down, wait, turn off"
		"• Perfect for contraption automation"
		""
		"§6§lPowered Latch:§r"
		"• Hold signal on/off"
		"• Great for toggle systems"
		""
		"§6§lRotation Speed Controller:§r"
		"• Set exact RPM with redstone"
		"• Target speed dial"
	]
	quest.4B00000000000160.title: "Redstone Automation"
	quest.4B00000000000170.quest_desc: [
		"§l§nTRAINS SYSTEM:§r"
		""
		"§6§lTrack Placement:§r"
		"• Place §6Track§r items on ground"
		"• §eRight-click§r with track to extend"
		"• Curves automatically form"
		"• Use §6Track Station§r for stops"
		""
		"§6§lBuilding Trains:§r"
		"1. Place §6Train Station§r"
		"2. Open station GUI"
		"3. Assemble train (bogeys + carriages)"
		"4. Add §6Train Casing§r for appearance"
		""
		"§6§lTrain Controls:§r"
		"• §6Conductor's Whistle§r: Manual control"
		"• §6Schedule§r: Automated routes"
		"• §6Train Signal§r: Prevent collisions"
		""
		"§eTIP: Trains can carry items, fluids, and players!§r"
	]
	quest.4B00000000000170.title: "Trains - Advanced Transport"
	quest.4B00000000000180.quest_desc: [
		"§l§nPONDER SYSTEM:§r"
		""
		"§6§lWhat is Ponder?§r"
		"Create's built-in tutorial system!"
		""
		"§6§lHow to Use:§r"
		"• Hold §eW§r while looking at Create item"
		"• In-world hologram demonstration appears"
		"• Shows how to use the item"
		"• Interactive 3D animations"
		""
		"§6§lPonder Shows You:§r"
		"• How to place and power machines"
		"• Common setups and configurations"
		"• What items can do"
		"• Multi-block structure requirements"
		""
		"§6§lBest Feature:§r"
		"• Better than any text guide!"
		"• See it in 3D action"
		"• Replay as many times as needed"
		""
		"§eTIP: Use Ponder on EVERYTHING in Create!§r"
	]
	quest.4B00000000000180.title: "Ponder - In-Game Tutorials"
	quest.4B00000000000190.quest_desc: [
		"§l§6Congratulations!§r"
		""
		"You've mastered the Create mod!"
		""
		"§l§nYou now know:§r"
		"• Rotational power and stress"
		"• All basic machines and processing"
		"• Belt systems and item logistics"
		"• Fluid handling"
		"• Contraptions and automation"
		"• Trains and transport"
		"• Redstone integration"
		"• And the almighty §ePonder§r system!"
		""
		"§6Go forth and engineer amazing contraptions!§r"
		""
		"§eRemember: When in doubt, Ponder it out!§r"
	]
	quest.4B00000000000190.title: "Create Master!"
