		"50% chance in treasure chests"
	]
	quest.47B1D8174CA61118.quest_desc: ["Just a normal trader with all the options of a villager trade but its a neat way to level them to master before you set up the auto trades."]
	quest.47B1D8174CA61118.title: "Normal Trader"
	quest.47D2EEAFB5ABF3B7.quest_desc: [
