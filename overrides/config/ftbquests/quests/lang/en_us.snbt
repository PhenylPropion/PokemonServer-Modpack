	quest.0060A61F752560DE.title: "Power Of Pure Light"
	quest.008CF47EFCD96F75.quest_desc: ["ポケモントレーナー セドリックとの遭遇 Iを達成し、勝利の証と名誉ある報酬を獲得します。"]
